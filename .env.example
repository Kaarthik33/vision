# Copy this file to .env and fill in what you need. Never commit your .env file.

# Which model to use: anthropic, openai, gemini or ollama.
# If unset, Vision uses the first provider below that has a key, else ollama.
VISION_PROVIDER=ollama
# Optional: override the default model for the provider.
# VISION_MODEL=llama3.1

# API keys (only the one for your chosen provider is needed; ollama needs none)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional settings
# VISION_WAKE_WORD=vision
# VISION_LANGUAGE=en-US
# VISION_VOICE_RATE=180
# OLLAMA_URL=http://localhost:11434
